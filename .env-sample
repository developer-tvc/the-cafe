# Application settings
# DEBUG must be False in production
DEBUG=
# Secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Your cafe's public domain (e.g. https://mycafe.com)
DOMAIN=
# Comma-separated list of allowed hostnames (e.g. mycafe.com,www.mycafe.com)
ALLOWED_HOSTS=

# MongoDB settings
# Connection string (optional — auto-built from below if not provided)
MONGO_DB=
# Credentials for MongoDB authentication
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Stripe payment settings
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAFE_IMAGE=

# Social auth (Google OAuth2)
# Get from https://console.cloud.google.com/apis/credentials
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_REST_GOOGLE_OAUTH2_URL=

# Auth redirect URLs
LOGIN_URL=/login/
LOGIN_REDIRECT_URL=/
LOGOUT_URL=/logout/
LOGOUT_REDIRECT_URL=/
ACCOUNT_LOGOUT_ON_GET=true
ACCOUNT_UNIQUE_EMAIL=true
ACCOUNT_EMAIL_REQUIRED=true
SOCIALACCOUNT_QUERY_EMAIL=true

# PostgreSQL / MySQL database (if using instead of MongoDB)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432